# A scoped read key from your LOCI org (loci_sk_…)
VITE_LOCI_KEY=

# The LOCI API origin (defaults to https://api.loci.ng in the app)
VITE_LOCI_BASE=https://api.loci.ng

# Optional: your own Mapbox public token. Leave unset to let the SDK borrow
# the deployment's token with your LOCI key.
VITE_MAPBOX_TOKEN=
